# Copia este archivo a .env y ajusta lo que necesites.
# Todas las variables tienen default en docker-compose.yml; el .env solo las
# sobreescribe.

# Puerto del mini-back en el host. El front lo hereda: NEXT_PUBLIC_API_BASE_URL
# se arma como http://localhost:${MINIBACK_PORT}/api.
# Ponlo en otro valor si ya tienes el backend real ocupando el 8000.
MINIBACK_PORT=8000

# account_id por default. Vacio = se resuelve leyendo
# addons/secrets/current_domain + addons/secrets/accounts.ini.
LKF_ACCOUNT_ID=

# Destino del proxy de login del mini-back.
LKF_UPSTREAM=https://app.linkaform.com

# Segundos maximos por script.
MINIBACK_TIMEOUT=120

# Segundos de vida del indice de scripts.
MINIBACK_INDEX_TTL=30

# Tope de scripts simultaneos. 0 = sin tope (cada corrida carga linkaform_api,
# asi que si la maquina sufre con muchas peticiones del front, pon 8).
MINIBACK_MAX_CONCURRENT=0

# Contenedores destino del `docker exec`. Cambialos solo para probar un
# worktree en paralelo, p.ej. LKF_ADDONS_CONTAINER=lkf-addons-<worktree>.
LKF_ADDONS_CONTAINER=lkf-addons
LKF_SANIC_CONTAINER=lkf-sanic-app
